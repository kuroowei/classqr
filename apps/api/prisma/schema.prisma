// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  PLATFORM_SUPER_ADMIN
  UNIVERSITY_SUPER_ADMIN
  FACULTY_ADMIN
  DEPARTMENT_ADMIN
  LECTURER
  STUDENT
}

enum InstitutionType {
  UNIVERSITY
  POLYTECHNIC
  COLLEGE
  OTHER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceSessionStatus {
  SCHEDULED
  ACTIVE
  CLOSED
  EXPIRED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

// ============================================================
// PLATFORM / TENANT
// ============================================================

model Institution {
  id        String          @id @default(cuid())
  name      String
  shortName String          @unique
  type      InstitutionType @default(UNIVERSITY)
  logoUrl   String?
  email     String?
  phone     String?
  address   String?
  website   String?
  country   String?
  region    String?
  timezone  String          @default("Africa/Lagos")
  currency  String          @default("NGN")
  status    RecordStatus    @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  users               User[]
  faculties           Faculty[]
  departments         Department[]
  programmes          Programme[]
  levels              Level[]
  academicSessions    AcademicSession[]
  semesters           Semester[]
  students            Student[]
  lecturers           Lecturer[]
  courses             Course[]
  courseRegistrations CourseRegistration[]
  lecturerCourses     LecturerCourse[]
  attendanceSessions  AttendanceSession[]
  attendanceRecords   AttendanceRecord[]
  auditLogs           AuditLog[]
}

model User {
  id            String       @id @default(cuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  email         String       @unique
  passwordHash  String
  role          UserRole
  status        RecordStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  studentProfile  Student?
  lecturerProfile Lecturer?
  auditLogs       AuditLog[]

  @@index([institutionId])
}

// ============================================================
// ACADEMIC HIERARCHY
// ============================================================

model Faculty {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  name          String
  code          String
  description   String?
  headOfFaculty String?
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  departments Department[]
  courses     Course[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Department {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  facultyId     String
  faculty       Faculty      @relation(fields: [facultyId], references: [id])
  name          String
  code          String
  headOfDept    String?
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  programmes Programme[]
  lecturers  Lecturer[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([facultyId])
}

model Programme {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id])
  name          String
  code          String
  degreeType    String?
  durationYears Int?
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  students Student[]
  courses  Course[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([departmentId])
}

model Level {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  students Student[]
  courses  Course[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model AcademicSession {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  name          String
  startDate     DateTime
  endDate       DateTime
  status        RecordStatus @default(ACTIVE)

  courses             Course[]
  courseRegistrations CourseRegistration[]
  attendanceSessions  AttendanceSession[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Semester {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  sortOrder     Int         @default(0)

  courses             Course[]
  courseRegistrations CourseRegistration[]
  attendanceSessions  AttendanceSession[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

// ============================================================
// PEOPLE
// ============================================================

model Student {
  id                 String       @id @default(cuid())
  institutionId      String
  institution        Institution  @relation(fields: [institutionId], references: [id])
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id])
  matricNumber       String
  firstName          String
  middleName         String?
  lastName           String
  phone              String?
  gender             String?
  programmeId        String
  programme          Programme    @relation(fields: [programmeId], references: [id])
  levelId            String
  level              Level        @relation(fields: [levelId], references: [id])
  admissionSessionId String?
  profilePhotoUrl    String?
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  courseRegistrations CourseRegistration[]
  attendanceRecords   AttendanceRecord[]

  @@unique([institutionId, matricNumber])
  @@index([institutionId])
  @@index([programmeId])
  @@index([levelId])
}

model Lecturer {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  staffId       String
  firstName     String
  lastName      String
  phone         String?
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id])
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lecturerCourses    LecturerCourse[]
  attendanceSessions AttendanceSession[]

  @@unique([institutionId, staffId])
  @@index([institutionId])
  @@index([departmentId])
}

// ============================================================
// COURSES & REGISTRATION
// ============================================================

model Course {
  id                String          @id @default(cuid())
  institutionId     String
  institution       Institution     @relation(fields: [institutionId], references: [id])
  facultyId         String
  faculty           Faculty         @relation(fields: [facultyId], references: [id])
  programmeId       String
  programme         Programme       @relation(fields: [programmeId], references: [id])
  levelId           String
  level             Level           @relation(fields: [levelId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  semesterId        String
  semester          Semester        @relation(fields: [semesterId], references: [id])
  code              String
  title             String
  description       String?
  creditUnit        Int             @default(1)
  status            RecordStatus    @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  courseRegistrations CourseRegistration[]
  lecturerCourses     LecturerCourse[]
  attendanceSessions  AttendanceSession[]

  @@unique([institutionId, code, academicSessionId, semesterId])
  @@index([institutionId])
}

model CourseRegistration {
  id                String          @id @default(cuid())
  institutionId     String
  institution       Institution     @relation(fields: [institutionId], references: [id])
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id])
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  semesterId        String
  semester          Semester        @relation(fields: [semesterId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([studentId, courseId, academicSessionId, semesterId])
  @@index([institutionId])
  @@index([courseId])
}

model LecturerCourse {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  lecturerId    String
  lecturer      Lecturer    @relation(fields: [lecturerId], references: [id])
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([lecturerId, courseId])
  @@index([institutionId])
}

// ============================================================
// ATTENDANCE
// ============================================================

model AttendanceSession {
  id                String                  @id @default(cuid())
  institutionId     String
  institution       Institution             @relation(fields: [institutionId], references: [id])
  courseId          String
  course            Course                  @relation(fields: [courseId], references: [id])
  lecturerId        String
  lecturer          Lecturer                @relation(fields: [lecturerId], references: [id])
  academicSessionId String
  academicSession   AcademicSession         @relation(fields: [academicSessionId], references: [id])
  semesterId        String
  semester          Semester                @relation(fields: [semesterId], references: [id])
  date              DateTime                @default(now())
  startTime         DateTime                @default(now())
  endTime           DateTime?
  status            AttendanceSessionStatus @default(SCHEDULED)
  qrToken           String                  @unique
  qrExpiresAt       DateTime
  createdAt         DateTime                @default(now())
  closedAt          DateTime?

  attendanceRecords AttendanceRecord[]

  @@index([institutionId])
  @@index([courseId])
  @@index([lecturerId])
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  institutionId       String
  institution         Institution       @relation(fields: [institutionId], references: [id])
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id])
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id])
  courseId            String
  checkInTime         DateTime          @default(now())
  status              AttendanceStatus  @default(PRESENT)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([studentId, attendanceSessionId])
  @@index([institutionId])
  @@index([attendanceSessionId])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id            String       @id @default(cuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  action        String
  resource      String
  resourceId    String?
  ipAddress     String?
  createdAt     DateTime     @default(now())

  @@index([institutionId])
  @@index([userId])
}